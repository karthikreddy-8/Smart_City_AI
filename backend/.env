# ─── SmartCity AI Backend Environment Variables ───────────────────────────────
# Copy this file to backend/.env and fill in your values.
# Never commit .env with real credentials to git.

# JWT Secret Key (change this in production!)
SECRET_KEY=smartcity_ai_super_secret_jwt_key_2026_btech_project_xyz

# Database URL
# Local SQLite (default - no setup needed):
DATABASE_URL=sqlite:///./smartcity_ai.db

# Production PostgreSQL (Neon / Railway / Render):
# DATABASE_URL=postgresql://user:password@host:5432/smartcity_db

# CORS Origins (comma separated) - leave empty to allow localhost only
# CORS_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com

# Token Expiry (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
