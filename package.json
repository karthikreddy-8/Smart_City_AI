{
  "name": "smart-city-ai-root",
  "version": "1.0.0",
  "description": "Root scripts wrapper for SmartCity AI Traffic congestion analytics system",
  "scripts": {
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "pip install -r backend/requirements.txt",
    "install:all": "npm run install:frontend && npm run install:backend",
    "build": "npm run build --prefix frontend",
    "start:frontend": "npm run dev --prefix frontend",
    "start:backend": "python backend/run.py",
    "generate-data": "python backend/generate_sample_data.py"
  },
  "keywords": [],
