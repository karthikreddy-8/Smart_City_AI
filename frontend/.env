# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment variables
# ─────────────────────────────────────────────────────────────────────────────

# LOCAL DEVELOPMENT (default):
# Vite proxies /api → http://127.0.0.1:8000 (your local backend)
# Keep this as /api so the Vite proxy works.
VITE_API_URL=https://smart-city-ai-d4re.onrender.com

# PRODUCTION / TESTING AGAINST RENDER:
# Uncomment the line below and comment out the /api line above.
# VITE_API_URL=https://smart-city-ai-d4re.onrender.com/api
